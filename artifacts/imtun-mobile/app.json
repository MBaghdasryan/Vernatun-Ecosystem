{
  "expo": {
    "name": "ImTun",
    "slug": "imtun-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imtun-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vernatun.imtun",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vernatun.imtun"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f5f3ed"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
