{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backup:encrypted-drill": "tsx archive/vernatun/server/operations-restore-cli.ts",
    "test:system": "cd archive/vernatun && node --import tsx server/tests/run.ts --system-only",
    "test:readiness": "cd archive/vernatun && node --import tsx server/tests/run.ts --readiness-only",
    "test:unit-plans": "cd archive/vernatun && node --import tsx server/tests/run.ts --unit-plans-only",
    "test:availability": "cd archive/vernatun && node --import tsx server/tests/run.ts --availability-only",
    "test:phase8": "cd archive/vernatun && tsx server/tests/run.ts --phase8-only",
    "test:phase7": "cd archive/vernatun && tsx server/tests/run.ts --phase7-only",
    "test:phase6-files": "cd archive/vernatun && tsx server/tests/run.ts --phase6-files-only",
    "test:core": "cd archive/vernatun && tsx server/tests/run.ts --core-only",
    "test:phase6": "cd archive/vernatun && tsx server/tests/run.ts --phase6-only",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx archive/vernatun/server/migrate.ts",
    "db:seed": "tsx archive/vernatun/server/seed.ts && tsx archive/vernatun/server/seed-modules.ts",
    "test:api": "cd archive/vernatun && tsx server/tests/run.ts",
    "test:seven-chains": "cd archive/vernatun && tsx server/tests/run.ts --seven-chains-only",
    "test:payments": "cd archive/vernatun && tsx server/tests/run.ts --payments-only",
    "test:storage": "cd archive/vernatun && tsx server/tests/run.ts --storage-only",
    "test:offline": "cd archive/vernatun && node --import tsx server/tests/run.ts --offline-only",
    "test:delivery": "cd archive/vernatun && tsx server/tests/run.ts --delivery-only",
    "test:edge": "cd archive/vernatun && tsx server/tests/run.ts --edge-only",
    "db:migrate:coolify:plan": "node dist/migrate.mjs --coolify-plan",
    "db:migrate:coolify:apply": "node dist/migrate.mjs --coolify-apply",
    "db:provision:edge-test-lab": "node archive/vernatun/server/scripts/provision-edge-test-lab.mjs",
    "db:recover:global-account": "node archive/vernatun/server/scripts/recover-global-account.mjs",
    "db:provision:global-accounts": "node archive/vernatun/server/scripts/provision-global-accounts.mjs",
    "storage:migrate": "tsx archive/vernatun/server/migrate-files.ts",
    "storage:inventory": "tsx archive/vernatun/server/inventory-files.ts",
    "backup:create": "tsx archive/vernatun/server/backup-files.ts create",
    "backup:drill": "tsx archive/vernatun/server/backup-files.ts drill",
    "test:backup": "cd archive/vernatun && tsx server/tests/run.ts --backup-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@google-cloud/storage": "^8.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.15",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5",
    "svix": "^2.6.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.13"
  }
}
