# Cloud bootstrap credential: obtain from Vernatun Cloud when Edge registration API is implemented.
VERNATUN_EDGE_BOOTSTRAP_TOKEN=

# Identity overrides. One unique Edge ID per ЖК/site.
VERNATUN_EDGE_ID=edge-building01
VERNATUN_EDGE_NAME=Vernatun Edge - Building 01
VERNATUN_TENANT_ID=uk_001
VERNATUN_BUILDING_ID=building01
VERNATUN_SITE_CODE=building01

# Cloud URLs
VERNATUN_CLOUD_API_BASE_URL=https://api.vernatun.io
VERNATUN_CLOUD_HEALTH_URL=https://api.vernatun.io/api/health

# Issued Edge credentials (optional until registration exists)
VERNATUN_EDGE_CLIENT_ID=
VERNATUN_EDGE_CLIENT_SECRET=
VERNATUN_EDGE_CLIENT_CERT_PATH=
VERNATUN_EDGE_CLIENT_KEY_PATH=
VERNATUN_EDGE_CA_CERT_PATH=

# Local Vernatun Command Authorization Layer
VERNATUN_EDGE_LOCAL_API_KEY=
VERNATUN_EDGE_COMMAND_URL=http://host.docker.internal:8091

# Local ThingsBoard
VERNATUN_TB_URL=http://host.docker.internal:8080
VERNATUN_TB_USERNAME=tenant@thingsboard.org
VERNATUN_TB_PASSWORD=tenant

# Local Agent API key
VERNATUN_AGENT_LOCAL_KEY=CHANGE_ME
