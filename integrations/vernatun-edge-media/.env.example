# Vernatun Edge Media v1
VERNATUN_EDGE_MEDIA_CONFIG=./config/vernatun_edge_media_v1.yaml

# Required for every /v1 endpoint. Configure the same local-only key in the Edge Agent.
VERNATUN_EDGE_MEDIA_API_KEY=
VERNATUN_EDGE_MEDIA_HOST=127.0.0.1
VERNATUN_EDGE_MEDIA_ALLOW_DOCKER_BRIDGE=false

# Optional overrides
VERNATUN_EDGE_MEDIA_HOST=127.0.0.1
VERNATUN_EDGE_MEDIA_PORT=8093
VERNATUN_MQTT_HOST=127.0.0.1
VERNATUN_MQTT_PORT=1884
